####################################################################################
# Constraints from file : 'key_ctrl_55_jm1.xdc'
####################################################################################

# PZ7035-FH / PZ7045-FH / PZ7100-FH: KEY1 and JM1 constraints
# Sources in /home/yyz/ALLdoc/zynq035:
#   06.开发板教程/...开发板教程.pdf, sections 2.3.17 and 2.3.21 (pp. 22, 25)
#   05.开发板原理图/...平台开发板原理图.pdf, sheets 3, 12 and 17
#
# Apply to design_1_wrapper ports key_0, rst_n_0 and out_1_1_0 through out_5_5_0.
# These names match the external ports generated by the Block Design.
# JM1 numbering follows the connector pin numbers, not physical left-to-right order.
# Use the first 25 signal pins (5..29); power/ground pins are excluded.
# LVCMOS33 assumes BANK10 VCCO = 3.3 V, matching the board's 3.3 V KEY1 pull-up.
#
# Clock: key_ctrl_55_0/clk is driven by the PS FCLK_CLK0 (100 MHz), internally:
# no PACKAGE_PIN or top-level create_clock constraint is needed here.
# The board's external PL oscillator is 200 MHz differential on H9/G9.
# It requires a differential input buffer/wrapper; do not bind clk directly
# to H9 using LVCMOS33. Set CLK_FREQ_HZ to the actual module clock frequency.
#
## External reset: SYS_nRST_O = AD18, active low (tutorial section 2.3.4).
#set_property -dict {PACKAGE_PIN AD18 IOSTANDARD LVCMOS33} [get_ports {rst_n_0}]

############## NET - IOSTANDARD ##################
# BD interface sys_clk_p expands into these two wrapper port bits.
current_instance -quiet
set_property PACKAGE_PIN H9 [get_ports {sys_clk_clk_p[0]}]
set_property PACKAGE_PIN G9 [get_ports {sys_clk_clk_n[0]}]
set_property IOSTANDARD DIFF_SSTL15 [get_ports {sys_clk_clk_p[0]}]
set_property IOSTANDARD DIFF_SSTL15 [get_ports {sys_clk_clk_n[0]}]

create_clock -period 5.000 -name sys_clk_p -waveform {0.000 2.500} [get_ports {sys_clk_clk_p[0]}]


set_property PACKAGE_PIN AD18 [get_ports rstn]
set_property IOSTANDARD LVCMOS33 [get_ports rstn]

# RFMC6000 AD9361 SPI0 via PS EMIO, master mode, SS0.
# Sources: RFMC6000 datasheet signal table and FMC9361_SCH.pdf;
# PZ7035-FH carrier schematic sheet 18, FMC-HPC connector J26.
# Reference adaloop_deepreads/dma_demo.v uses SPI0 for AD9361;
# SPI1 in that example configures CDCM6208 and is a separate bus.
# User confirmed FMC VADJ and BANK12/13 VCCO = 1.8 V.
# Logical port       AD9361 signal   FMC contact / net    FPGA ball
# SPI_9361_io0_io    SPI_MOSI        C22 / LA18_P_CC      U25
# SPI_9361_io1_io    SPI_MISO        G21 / LA20_P         N26
# SPI_9361_sck_io    SPI_CLK         C23 / LA18_N_CC      V26
# SPI_9361_ss_io     SPI_CS#         H22 / LA19_P         T22
# Legacy RFMC6000 constraints retained below; active board: fmcomms3_io.xdc.
# set_property -dict {PACKAGE_PIN U25 IOSTANDARD LVCMOS18} [get_ports {SPI_9361_io0_io}]
# set_property -dict {PACKAGE_PIN N26 IOSTANDARD LVCMOS18} [get_ports {SPI_9361_io1_io}]
# set_property -dict {PACKAGE_PIN V26 IOSTANDARD LVCMOS18} [get_ports {SPI_9361_sck_io}]
# set_property -dict {PACKAGE_PIN T22 IOSTANDARD LVCMOS18 PULLUP true} [get_ports {SPI_9361_ss_io}]

# RFMC6000 CDCM6208 SPI1 via PS EMIO, master mode, SS0 (software mode 0).
# Map by physical FMC contacts: the module and carrier LA labels differ.
# Sources: FMC9361_SCH.pdf sheet 2 and PZ7035-FH carrier sheet 18.
# Logical port       CDCM6208 signal  FMC contact  Carrier net  FPGA ball
# SPI_6208_io0_io    CDCM_SPI_MOSI    H35          LA30_N       AK26
# SPI_6208_io1_io    CDCM_SPI_MISO    G34          LA31_N       AE26
# SPI_6208_sck_io    CDCM_SPI_CLK     G31          LA29_N       AA30
# SPI_6208_ss_io     CDCM_SPI_CS      H34          LA30_P       AJ26
# BANK12 VCCO/VADJ = 1.8 V. SPI is single-ended; use no differential buffers.
# set_property -dict {PACKAGE_PIN AK26 IOSTANDARD LVCMOS18} [get_ports {SPI_6208_io0_io}]
# set_property -dict {PACKAGE_PIN AE26 IOSTANDARD LVCMOS18} [get_ports {SPI_6208_io1_io}]
# set_property -dict {PACKAGE_PIN AA30 IOSTANDARD LVCMOS18} [get_ports {SPI_6208_sck_io}]
# set_property -dict {PACKAGE_PIN AJ26 IOSTANDARD LVCMOS18 PULLUP true} [get_ports {SPI_6208_ss_io}]

# AD9361 active-low hardware reset via PS GPIO EMIO[0] (XGpioPs pin 54).
# RFMC6000 RESETB -> FMC D23 / LA23_P -> PZ7035-FH J26 -> FPGA T29.
# Matches the reference RF1_RESETB=0 GPIO mapping; package pin and voltage
# are adapted to this carrier's 1.8 V VADJ/BANK13, not the example carrier.
# The module already has a 10 kOhm pull-up to VADJ on RESETB (RA2).
# set_property -dict {PACKAGE_PIN T29 IOSTANDARD LVCMOS18} [get_ports {GPIO_PS_tri_io[0]}]

#
# KEY1: released = 1, pressed = 0. The RTL preserves the key input polarity.
set_property -dict {PACKAGE_PIN AB12 IOSTANDARD LVCMOS33} [get_ports key_0]

# Output port -> JM1 connector pin -> FPGA package pin (BANK10).

# out_1_1_0 -> JM1-5 -> AH14
set_property -dict {PACKAGE_PIN AH14 IOSTANDARD LVCMOS33} [get_ports out_1_1_0]
# out_1_2_0 -> JM1-6 -> AF14
set_property -dict {PACKAGE_PIN AF14 IOSTANDARD LVCMOS33} [get_ports out_1_2_0]
# out_1_3_0 -> JM1-7 -> AH13
set_property -dict {PACKAGE_PIN AH13 IOSTANDARD LVCMOS33} [get_ports out_1_3_0]
# out_1_4_0 -> JM1-8 -> AG14
set_property -dict {PACKAGE_PIN AG14 IOSTANDARD LVCMOS33} [get_ports out_1_4_0]
# out_1_5_0 -> JM1-9 -> AJ15
set_property -dict {PACKAGE_PIN AJ15 IOSTANDARD LVCMOS33} [get_ports out_1_5_0]

# out_2_1_0 -> JM1-10 -> AB15
set_property -dict {PACKAGE_PIN AB15 IOSTANDARD LVCMOS33} [get_ports out_2_1_0]
# out_2_2_0 -> JM1-11 -> AK15
set_property -dict {PACKAGE_PIN AK15 IOSTANDARD LVCMOS33} [get_ports out_2_2_0]
# out_2_3_0 -> JM1-12 -> AB14
set_property -dict {PACKAGE_PIN AB14 IOSTANDARD LVCMOS33} [get_ports out_2_3_0]
# out_2_4_0 -> JM1-13 -> AJ14
set_property -dict {PACKAGE_PIN AJ14 IOSTANDARD LVCMOS33} [get_ports out_2_4_0]
# out_2_5_0 -> JM1-14 -> AC14
set_property -dict {PACKAGE_PIN AC14 IOSTANDARD LVCMOS33} [get_ports out_2_5_0]

# out_3_1_0 -> JM1-15 -> AJ13
set_property -dict {PACKAGE_PIN AJ13 IOSTANDARD LVCMOS33} [get_ports out_3_1_0]
# out_3_2_0 -> JM1-16 -> AC13
set_property -dict {PACKAGE_PIN AC13 IOSTANDARD LVCMOS33} [get_ports out_3_2_0]
# out_3_3_0 -> JM1-17 -> AD16
set_property -dict {PACKAGE_PIN AD16 IOSTANDARD LVCMOS33} [get_ports out_3_3_0]
# out_3_4_0 -> JM1-18 -> AH17
set_property -dict {PACKAGE_PIN AH17 IOSTANDARD LVCMOS33} [get_ports out_3_4_0]
# out_3_5_0 -> JM1-19 -> AD15
set_property -dict {PACKAGE_PIN AD15 IOSTANDARD LVCMOS33} [get_ports out_3_5_0]

# out_4_1_0 -> JM1-20 -> AH16
set_property -dict {PACKAGE_PIN AH16 IOSTANDARD LVCMOS33} [get_ports out_4_1_0]
# out_4_2_0 -> JM1-21 -> AF15
set_property -dict {PACKAGE_PIN AF15 IOSTANDARD LVCMOS33} [get_ports out_4_2_0]
# out_4_3_0 -> JM1-22 -> AE16
set_property -dict {PACKAGE_PIN AE16 IOSTANDARD LVCMOS33} [get_ports out_4_3_0]
# out_4_4_0 -> JM1-23 -> AG15
set_property -dict {PACKAGE_PIN AG15 IOSTANDARD LVCMOS33} [get_ports out_4_4_0]
# out_4_5_0 -> JM1-24 -> AE15
set_property -dict {PACKAGE_PIN AE15 IOSTANDARD LVCMOS33} [get_ports out_4_5_0]

# out_5_1_0 -> JM1-25 -> AE18
set_property -dict {PACKAGE_PIN AE18 IOSTANDARD LVCMOS33} [get_ports out_5_1_0]
# out_5_2_0 -> JM1-26 -> AC17
set_property -dict {PACKAGE_PIN AC17 IOSTANDARD LVCMOS33} [get_ports out_5_2_0]
# out_5_3_0 -> JM1-27 -> AE17
set_property -dict {PACKAGE_PIN AE17 IOSTANDARD LVCMOS33} [get_ports out_5_3_0]
# out_5_4_0 -> JM1-28 -> AC16
set_property -dict {PACKAGE_PIN AC16 IOSTANDARD LVCMOS33} [get_ports out_5_4_0]
# # out_5_5_0 -> JM1-29 -> AG17
set_property -dict {PACKAGE_PIN AG17 IOSTANDARD LVCMOS33} [get_ports out_5_5_0]

# FMC G36 / carrier J4-106: release CDCM6208 physical SYNCN.
# Output divider synchronization is driven by SPI register R3.5.
# set_property -dict {PACKAGE_PIN AG26 IOSTANDARD LVCMOS18} [get_ports {cdcm_sync}]


####################################################################################
# Constraints from file : 'rfmc6000_iq_axis_io.xdc'
####################################################################################

# LEGACY RFMC6000: all board I/O commands commented; retained for reference.
# Active daughterboard constraints: fmcomms3_io.xdc.
# RFMC6000 RX pin template for PZ7035-FH, xc7z035ffg900.
# Add to the project ONLY after these 16 physical ports exist at the top.
# Rename ports below if BD Make External adds a suffix. This file is NOT
# scoped to the RTL reference; package-pin constraints apply to top ports.
# BANK12/13 VCCO=1.8 V; receiver LVDS_25, external differential termination.
# set_property -dict {PACKAGE_PIN AB27 IOSTANDARD LVDS_25 DIFF_TERM false} [get_ports rx_clk_p]
# set_property -dict {PACKAGE_PIN AC27 IOSTANDARD LVDS_25 DIFF_TERM false} [get_ports rx_clk_n]
# set_property -dict {PACKAGE_PIN T30 IOSTANDARD LVDS_25 DIFF_TERM false} [get_ports rx_frame_p]
# set_property -dict {PACKAGE_PIN U30 IOSTANDARD LVDS_25 DIFF_TERM false} [get_ports rx_frame_n]
# set_property -dict {PACKAGE_PIN W29 IOSTANDARD LVDS_25 DIFF_TERM false} [get_ports {rx_data_p[0]}]
# set_property -dict {PACKAGE_PIN W30 IOSTANDARD LVDS_25 DIFF_TERM false} [get_ports {rx_data_n[0]}]
# set_property -dict {PACKAGE_PIN U24 IOSTANDARD LVDS_25 DIFF_TERM false} [get_ports {rx_data_p[1]}]
# set_property -dict {PACKAGE_PIN V24 IOSTANDARD LVDS_25 DIFF_TERM false} [get_ports {rx_data_n[1]}]
# set_property -dict {PACKAGE_PIN T24 IOSTANDARD LVDS_25 DIFF_TERM false} [get_ports {rx_data_p[2]}]
# set_property -dict {PACKAGE_PIN T25 IOSTANDARD LVDS_25 DIFF_TERM false} [get_ports {rx_data_n[2]}]
# set_property -dict {PACKAGE_PIN N28 IOSTANDARD LVDS_25 DIFF_TERM false} [get_ports {rx_data_p[3]}]
# set_property -dict {PACKAGE_PIN P28 IOSTANDARD LVDS_25 DIFF_TERM false} [get_ports {rx_data_n[3]}]
# set_property -dict {PACKAGE_PIN U22 IOSTANDARD LVDS_25 DIFF_TERM false} [get_ports {rx_data_p[4]}]
# set_property -dict {PACKAGE_PIN V22 IOSTANDARD LVDS_25 DIFF_TERM false} [get_ports {rx_data_n[4]}]
# set_property -dict {PACKAGE_PIN P21 IOSTANDARD LVDS_25 DIFF_TERM false} [get_ports {rx_data_p[5]}]
# set_property -dict {PACKAGE_PIN R21 IOSTANDARD LVDS_25 DIFF_TERM false} [get_ports {rx_data_n[5]}]
# Maximum dual-RX rate: Fs=61.44 MSPS, DATA_CLK=4*Fs=245.76 MHz.
# Change this period if the configured sample rate differs; use only one
# create_clock on this port. Board-specific DDR set_input_delay values must
# be added from AD9361 output timing, actual interface delay and PCB skew.
# create_clock -name rfmc_rx -period 4.069 [get_ports rx_clk_p]


####################################################################################
# Constraints from file : 'fmcomms3_io.xdc'
####################################################################################

# AD-FMCOMMS3-EBZ Rev.A on PZ7035-FH J26 FMC-HPC.
# Sources: ad-fmcomms3_reva.pdf sheets 2/3/4 and carrier schematic sheet 18.
# Map PHYSICAL FMC contacts, not the old RFMC6000 module's LA labels.
# Carrier FMC LA banks and VADJ default to 1.8 V.

# SPI0 EMIO, CPOL=0/CPHA=1, SS0; DI/DO directions relative to AD9361.
# DI C26 -> AF30; DO C27 -> AG30; CLK D27 -> AK30; ENB D26 -> AJ30.
set_property -dict {PACKAGE_PIN AF30 IOSTANDARD LVCMOS18} [get_ports SPI_9361_io0_io]
set_property -dict {PACKAGE_PIN AG30 IOSTANDARD LVCMOS18} [get_ports SPI_9361_io1_io]
set_property -dict {PACKAGE_PIN AK30 IOSTANDARD LVCMOS18} [get_ports SPI_9361_sck_io]
set_property PACKAGE_PIN AJ30 [get_ports SPI_9361_ss_io]
set_property IOSTANDARD LVCMOS18 [get_ports SPI_9361_ss_io]
set_property PULLUP true [get_ports SPI_9361_ss_io]
# RESETB: H31 / LA28_P -> AC29; PS GPIO EMIO[0], XGpioPs pin 54.
# Module R103 already pulls RESETB to VDD_INTERFACE through 10 kOhm.
set_property -dict {PACKAGE_PIN AC29 IOSTANDARD LVCMOS18} [get_ports {GPIO_PS_tri_io[0]}]

# Register-controlled ENSM/MGC. External controls held low in board top.
# ENABLE G18; TXNRX G19; EN_AGC H22; SYNC_IN H23.
set_property -dict {PACKAGE_PIN P25 IOSTANDARD LVCMOS18} [get_ports rf_enable]
set_property -dict {PACKAGE_PIN P26 IOSTANDARD LVCMOS18} [get_ports rf_txnrx]
set_property -dict {PACKAGE_PIN T22 IOSTANDARD LVCMOS18} [get_ports rf_en_agc]
set_property -dict {PACKAGE_PIN T23 IOSTANDARD LVCMOS18} [get_ports rf_sync_in]

# DATA_CLK G6/G7; RX_FRAME D8/D9.
# LVDS_25 input-only operation with 1.8 V HR-bank VCCO requires DIFF_TERM=false
# (UG471). Do not enable the 2.5 V HR termination at 1.8 V. The FMCOMMS3
# schematic shows no external RX 100 Ohm termination: verify receive signal
# integrity / physical termination before claiming lossless IQ capture.
set_property -dict {PACKAGE_PIN R27 IOSTANDARD LVDS_25 DIFF_TERM 0} [get_ports rx_clk_p]
set_property -dict {PACKAGE_PIN T27 IOSTANDARD LVDS_25 DIFF_TERM 0} [get_ports rx_clk_n]
set_property -dict {PACKAGE_PIN R25 IOSTANDARD LVDS_25 DIFF_TERM 0} [get_ports rx_frame_p]
set_property -dict {PACKAGE_PIN R26 IOSTANDARD LVDS_25 DIFF_TERM 0} [get_ports rx_frame_n]
# RX_D0 H7/H8; D1 G9/G10; D2 H10/H11; D3 D11/D12;
# D4 C10/C11; D5 H13/H14. Preserve physical P/N polarity.
set_property -dict {PACKAGE_PIN P21 IOSTANDARD LVDS_25 DIFF_TERM 0} [get_ports {rx_data_p[0]}]
set_property -dict {PACKAGE_PIN R21 IOSTANDARD LVDS_25 DIFF_TERM 0} [get_ports {rx_data_n[0]}]
set_property -dict {PACKAGE_PIN N28 IOSTANDARD LVDS_25 DIFF_TERM 0} [get_ports {rx_data_p[1]}]
set_property -dict {PACKAGE_PIN P28 IOSTANDARD LVDS_25 DIFF_TERM 0} [get_ports {rx_data_n[1]}]
set_property -dict {PACKAGE_PIN T24 IOSTANDARD LVDS_25 DIFF_TERM 0} [get_ports {rx_data_p[2]}]
set_property -dict {PACKAGE_PIN T25 IOSTANDARD LVDS_25 DIFF_TERM 0} [get_ports {rx_data_n[2]}]
set_property -dict {PACKAGE_PIN U22 IOSTANDARD LVDS_25 DIFF_TERM 0} [get_ports {rx_data_p[3]}]
set_property -dict {PACKAGE_PIN V22 IOSTANDARD LVDS_25 DIFF_TERM 0} [get_ports {rx_data_n[3]}]
set_property -dict {PACKAGE_PIN T30 IOSTANDARD LVDS_25 DIFF_TERM 0} [get_ports {rx_data_p[4]}]
set_property -dict {PACKAGE_PIN U30 IOSTANDARD LVDS_25 DIFF_TERM 0} [get_ports {rx_data_n[4]}]
set_property -dict {PACKAGE_PIN N29 IOSTANDARD LVDS_25 DIFF_TERM 0} [get_ports {rx_data_p[5]}]
set_property -dict {PACKAGE_PIN P29 IOSTANDARD LVDS_25 DIFF_TERM 0} [get_ports {rx_data_n[5]}]

# Active config915: Fs=15.36 MSPS, dual RX LVDS DDR, DATA_CLK=61.44 MHz.
# SPI timing scan may change phase, never this frequency.
create_clock -period 16.276 -name rfmc_rx [get_ports rx_clk_p]


####################################################################################
# Constraints from file : 'ad9361_rx_cdc.xdc'
####################################################################################

# Companion to the rewritten ad9361_rx_axis (scoped to this reference).
# Reset, one-bit status/ARM, counters and the async FIFO use XPM primitives.
# Their generated XDC constrains the first synchronizer stages and Gray buses.
# ADI register/control transfers use the separately loaded vendor XDC files.
# No clock-group false paths: later synchronizer stages and unrelated paths
# remain timed. No names from the removed local frontend are constrained here.


