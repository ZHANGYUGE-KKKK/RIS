<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="z035_basic"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
z035_basic
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="z035_basic">
        <sdx:configuration sdx:name="z035_basic"
                           sdx:displayName="z035_basic"
                           sdx:defaultProcessorGroup="standalone_domain"
                           sdx:runtimes="cpp">
            <sdx:description>z035_basic</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="z035_basic/boot/z035_basic.bif"
                            sdx:readme="z035_basic/boot/generic.readme"
                            sdx:qemuArguments="z035_basic/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="standalone_domain"
                            sdx:bif="z035_basic/boot/z035_basic.bif"
                            sdx:readme="z035_basic/boot/generic.readme"
                            sdx:qemuArguments="z035_basic/standalone_domain/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_domain"
                                sdx:displayName="standalone on ps7_cortexa9_0"
                                sdx:cpuType="cortex-a9"
                                sdx:cpuInstance="ps7_cortexa9_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="z035_basic/standalone_domain/bsplib/lib"
                        sdx:bspIncludePaths="z035_basic/standalone_domain/bspinclude/include"
                        sdx:bspConfig="z035_basic/standalone_domain/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
