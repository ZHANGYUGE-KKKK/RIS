   CONFIG.PCW_UART0_GRP_FULL_ENABLE {0} \
   CONFIG.PCW_UART0_PERIPHERAL_ENABLE {0} \
   CONFIG.PCW_UART1_GRP_FULL_ENABLE {0} \
   CONFIG.PCW_UART1_PERIPHERAL_ENABLE {1} \
   CONFIG.PCW_UART1_UART1_IO {MIO 48 .. 49} \
   CONFIG.PCW_UART_PERIPHERAL_DIVISOR0 {18} \
   CONFIG.PCW_UART_PERIPHERAL_FREQMHZ {100} \
   CONFIG.PCW_UART_PERIPHERAL_VALID {1} \
   CONFIG.PCW_UIPARAM_ACT_DDR_FREQ_MHZ {533.333374} \
   CONFIG.PCW_UIPARAM_DDR_BANK_ADDR_COUNT {3} \
   CONFIG.PCW_UIPARAM_DDR_BL {8} \
   CONFIG.PCW_UIPARAM_DDR_BOARD_DELAY0 {0.521} \
   CONFIG.PCW_UIPARAM_DDR_BOARD_DELAY1 {0.636} \
   CONFIG.PCW_UIPARAM_DDR_BOARD_DELAY2 {0.54} \
   CONFIG.PCW_UIPARAM_DDR_BOARD_DELAY3 {0.621} \
   CONFIG.PCW_UIPARAM_DDR_BUS_WIDTH {32 Bit} \
   CONFIG.PCW_UIPARAM_DDR_CL {7} \
   CONFIG.PCW_UIPARAM_DDR_COL_ADDR_COUNT {10} \
   CONFIG.PCW_UIPARAM_DDR_CWL {6} \
   CONFIG.PCW_UIPARAM_DDR_DEVICE_CAPACITY {2048 MBits} \
   CONFIG.PCW_UIPARAM_DDR_DQS_TO_CLK_DELAY_0 {0.226} \
   CONFIG.PCW_UIPARAM_DDR_DQS_TO_CLK_DELAY_1 {0.278} \
   CONFIG.PCW_UIPARAM_DDR_DQS_TO_CLK_DELAY_2 {0.184} \
   CONFIG.PCW_UIPARAM_DDR_DQS_TO_CLK_DELAY_3 {0.309} \
   CONFIG.PCW_UIPARAM_DDR_DRAM_WIDTH {8 Bits} \
   CONFIG.PCW_UIPARAM_DDR_ECC {Disabled} \
   CONFIG.PCW_UIPARAM_DDR_FREQ_MHZ {533.333313} \
   CONFIG.PCW_UIPARAM_DDR_MEMORY_TYPE {DDR 3} \
   CONFIG.PCW_UIPARAM_DDR_PARTNO {Custom} \
   CONFIG.PCW_UIPARAM_DDR_ROW_ADDR_COUNT {15} \
   CONFIG.PCW_UIPARAM_DDR_SPEED_BIN {DDR3_1066F} \
   CONFIG.PCW_UIPARAM_DDR_TRAIN_DATA_EYE {1} \
   CONFIG.PCW_UIPARAM_DDR_TRAIN_READ_GATE {1} \
   CONFIG.PCW_UIPARAM_DDR_TRAIN_WRITE_LEVEL {1} \
   CONFIG.PCW_UIPARAM_DDR_T_FAW {30.0} \
   CONFIG.PCW_UIPARAM_DDR_T_RAS_MIN {36.0} \
   CONFIG.PCW_UIPARAM_DDR_T_RC {49.5} \
   CONFIG.PCW_UIPARAM_DDR_T_RCD {7} \
   CONFIG.PCW_UIPARAM_DDR_T_RP {7} \
   CONFIG.PCW_UIPARAM_DDR_USE_INTERNAL_VREF {1} \
   CONFIG.PCW_USB0_PERIPHERAL_ENABLE {0} \
   CONFIG.PCW_USB0_PERIPHERAL_FREQMHZ {60} \
   CONFIG.PCW_USB0_RESET_ENABLE {0} \
   CONFIG.PCW_USB0_RESET_IO {<Select>} \
   CONFIG.PCW_USB0_USB0_IO {<Select>} \
   CONFIG.PCW_USB1_RESET_ENABLE {0} \
   CONFIG.PCW_USB_RESET_ENABLE {1} \
   CONFIG.PCW_USB_RESET_SELECT {<Select>} \
   CONFIG.PCW_USE_M_AXI_GP0 {1} \
   CONFIG.PCW_USE_M_AXI_GP1 {0} \
   CONFIG.PCW_USE_S_AXI_HP0 {0} \
   CONFIG.PCW_WDT_PERIPHERAL_ENABLE {0} \
   CONFIG.PCW_WDT_PERIPHERAL_FREQMHZ {133.333333} \
 ] $ps7

  # Create instance: reset_cpu, and set properties
  set reset_cpu [ create_bd_cell -type ip -vlnv xilinx.com:ip:proc_sys_reset:5.0 reset_cpu ]
  set_property -dict [ list \
   CONFIG.C_AUX_RESET_HIGH {0} \
 ] $reset_cpu

  # Create instance: reset_ddr, and set properties
  set reset_ddr [ create_bd_cell -type ip -vlnv xilinx.com:ip:proc_sys_reset:5.0 reset_ddr ]
  set_property -dict [ list \
   CONFIG.C_AUX_RESET_HIGH {0} \
 ] $reset_ddr

  # Create instance: value_gpio, and set properties
  set value_gpio [ create_bd_cell -type ip -vlnv xilinx.com:ip:axi_gpio:2.0 value_gpio ]
  set_property -dict [ list \
   CONFIG.C_ALL_INPUTS {1} \
   CONFIG.C_ALL_INPUTS_2 {1} \
   CONFIG.C_GPIO2_WIDTH {32} \
   CONFIG.C_GPIO_WIDTH {32} \
   CONFIG.C_IS_DUAL {1} \
 ] $value_gpio

  # Create interface connections
  connect_bd_intf_net -intf_net bist_M_AXI [get_bd_intf_pins bist/M_AXI] [get_bd_intf_pins mig/S_AXI]
  connect_bd_intf_net -intf_net control_bus_M00_AXI [get_bd_intf_pins control_bus/M00_AXI] [get_bd_intf_pins control_gpio/S_AXI]
  connect_bd_intf_net -intf_net control_bus_M01_AXI [get_bd_intf_pins control_bus/M01_AXI] [get_bd_intf_pins error_gpio/S_AXI]
  connect_bd_intf_net -intf_net control_bus_M02_AXI [get_bd_intf_pins control_bus/M02_AXI] [get_bd_intf_pins value_gpio/S_AXI]
  connect_bd_intf_net -intf_net mig_DDR3 [get_bd_intf_ports DDR3] [get_bd_intf_pins mig/DDR3]
  connect_bd_intf_net -intf_net ps7_DDR [get_bd_intf_ports DDR] [get_bd_intf_pins ps7/DDR]
  connect_bd_intf_net -intf_net ps7_FIXED_IO [get_bd_intf_ports FIXED_IO] [get_bd_intf_pins ps7/FIXED_IO]
  connect_bd_intf_net -intf_net ps7_M_AXI_GP0 [get_bd_intf_pins control_bus/S00_AXI] [get_bd_intf_pins ps7/M_AXI_GP0]
  connect_bd_intf_net -intf_net sys_clk_1 [get_bd_intf_ports sys_clk] [get_bd_intf_pins clkbuf/CLK_IN_D]

  # Create port connections
  connect_bd_net -net bist_error_words [get_bd_pins bist/error_words] [get_bd_pins diag/errors_async]
  connect_bd_net -net bist_first_actual [get_bd_pins bist/first_actual] [get_bd_pins diag/actual_async]
  connect_bd_net -net bist_first_bad_address [get_bd_pins bist/first_bad_address] [get_bd_pins diag/address_async]
  connect_bd_net -net bist_first_expected [get_bd_pins bist/first_expected] [get_bd_pins diag/expected_async]
  connect_bd_net -net bist_status [get_bd_pins bist/status] [get_bd_pins diag/status_async]
  connect_bd_net -net clkbuf_IBUF_OUT [get_bd_pins clkbuf/IBUF_OUT] [get_bd_pins mig/clk_ref_i] [get_bd_pins mig_clock/clk_in1]
  connect_bd_net -net control_gpio_gpio_io_o [get_bd_pins bist/command] [get_bd_pins control_gpio/gpio_io_o]
  connect_bd_net -net cpu_reset_1 [get_bd_ports cpu_reset] [get_bd_pins inv_reset/Op1] [get_bd_pins mig_clock/reset]
  connect_bd_net -net diag_actual [get_bd_pins diag/actual] [get_bd_pins value_gpio/gpio2_io_i]
  connect_bd_net -net diag_address [get_bd_pins diag/address] [get_bd_pins error_gpio/gpio_io_i]
  connect_bd_net -net diag_errors [get_bd_pins diag/errors] [get_bd_pins error_gpio/gpio2_io_i]
  connect_bd_net -net diag_expected [get_bd_pins diag/expected] [get_bd_pins value_gpio/gpio_io_i]
  connect_bd_net -net diag_status [get_bd_pins control_gpio/gpio2_io_i] [get_bd_pins diag/status]
  connect_bd_net -net inv_reset_Res [get_bd_pins inv_reset/Res] [get_bd_pins mig_reset_gate/Op1]
  connect_bd_net -net mig_clock_clk_out1 [get_bd_pins mig/sys_clk_i] [get_bd_pins mig_clock/clk_out1]
  connect_bd_net -net mig_clock_locked [get_bd_pins mig_clock/locked] [get_bd_pins mig_reset_gate/Op2]
  connect_bd_net -net mig_init_calib_complete [get_bd_pins bist/calib_complete] [get_bd_pins mig/init_calib_complete]
  connect_bd_net -net mig_mmcm_locked [get_bd_pins bist/mmcm_locked] [get_bd_pins mig/mmcm_locked] [get_bd_pins reset_cpu/dcm_locked] [get_bd_pins reset_ddr/dcm_locked]
  connect_bd_net -net mig_reset_gate_Res [get_bd_pins mig/sys_rst] [get_bd_pins mig_reset_gate/Res]
  connect_bd_net -net mig_ui_clk [get_bd_pins bist/aclk] [get_bd_pins mig/ui_clk] [get_bd_pins reset_ddr/slowest_sync_clk]
  connect_bd_net -net mig_ui_clk_sync_rst [get_bd_pins bist/ui_reset] [get_bd_pins mig/ui_clk_sync_rst] [get_bd_pins reset_ddr/ext_reset_in]
  connect_bd_net -net ps7_FCLK_CLK0 [get_bd_pins control_bus/ACLK] [get_bd_pins control_bus/M00_ACLK] [get_bd_pins control_bus/M01_ACLK] [get_bd_pins control_bus/M02_ACLK] [get_bd_pins control_bus/S00_ACLK] [get_bd_pins control_gpio/s_axi_aclk] [get_bd_pins diag/clk] [get_bd_pins error_gpio/s_axi_aclk] [get_bd_pins ps7/FCLK_CLK0] [get_bd_pins ps7/M_AXI_GP0_ACLK] [get_bd_pins reset_cpu/slowest_sync_clk] [get_bd_pins value_gpio/s_axi_aclk]
  connect_bd_net -net ps7_FCLK_RESET0_N [get_bd_pins ps7/FCLK_RESET0_N] [get_bd_pins reset_cpu/ext_reset_in] [get_bd_pins reset_ddr/aux_reset_in]
  connect_bd_net -net reset_cpu_interconnect_aresetn [get_bd_pins control_bus/ARESETN] [get_bd_pins control_bus/M00_ARESETN] [get_bd_pins control_bus/M01_ARESETN] [get_bd_pins control_bus/M02_ARESETN] [get_bd_pins control_bus/S00_ARESETN] [get_bd_pins reset_cpu/interconnect_aresetn]
  connect_bd_net -net reset_cpu_peripheral_aresetn [get_bd_pins control_gpio/s_axi_aresetn] [get_bd_pins diag/resetn] [get_bd_pins error_gpio/s_axi_aresetn] [get_bd_pins reset_cpu/peripheral_aresetn] [get_bd_pins value_gpio/s_axi_aresetn]
  connect_bd_net -net reset_ddr_peripheral_aresetn [get_bd_pins bist/aresetn] [get_bd_pins mig/aresetn] [get_bd_pins reset_ddr/peripheral_aresetn]

  # Create address segments
  assign_bd_address -offset 0x00000000 -range 0x80000000 -target_address_space [get_bd_addr_spaces bist/M_AXI] [get_bd_addr_segs mig/memmap/memaddr] -force
  assign_bd_address -offset 0x41200000 -range 0x00010000 -target_address_space [get_bd_addr_spaces ps7/Data] [get_bd_addr_segs control_gpio/S_AXI/Reg] -force
  assign_bd_address -offset 0x41210000 -range 0x00010000 -target_address_space [get_bd_addr_spaces ps7/Data] [get_bd_addr_segs error_gpio/S_AXI/Reg] -force
  assign_bd_address -offset 0x41220000 -range 0x00010000 -target_address_space [get_bd_addr_spaces ps7/Data] [get_bd_addr_segs value_gpio/S_AXI/Reg] -force


  # Restore current instance
  current_bd_instance $oldCurInst

  validate_bd_design
  save_bd_design
}
