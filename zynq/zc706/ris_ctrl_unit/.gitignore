# Keep accepted board download packages despite the repository-wide binary rules.
!/export/*.bit
!/export/*.elf
!/export_network/*.bit
!/export_network/*.elf
!/export_network_fast/*.bit
!/export_network_fast/*.elf
!/export_mt/*.bit
!/export_mt/*.elf
!/export_flash/20261029_mt/*.bin
!/export_flash/20261029_mt/*.bit
!/export_flash/20261029_mt/*.elf

# The debugger launch configuration is part of the reproducible GUI workflow.
!/vitis_fast/ris_fast_network/_ide/
