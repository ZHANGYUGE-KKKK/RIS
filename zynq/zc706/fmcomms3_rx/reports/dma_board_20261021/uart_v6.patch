+/* UART-only bulk capture keeps board diagnostics usable without changing
+ * the workstation's network connection. Releasing a frozen buffer is an
+ * explicit command; a new capture never silently overwrites it. */
+static int rx_debug_console(char key)
+{
+    int status;
+    u32 bytes;
+    if (key == 'r' || key == 'R') {
+        status = capture_store_release(capture_store.id);
+        xil_printf("RXDBG UART RELEASE result=%d state=%s\r\n", status, capture_store_state_name());
+        return 1;
+    }
+    if (key != 'c' && key != 'C' && key != 'v' && key != 'V') return 0;
+    bytes = key == 'c' || key == 'C' ? 8U*1024U*1024U : CAPTURE_SAMPLE_RATE*CAPTURE_TUPLE_BYTES;
+    xil_printf("RXDBG UART BEGIN bytes=%u; RF configuration unchanged\r\n", (unsigned)bytes);
+    status = capture_store_begin(bytes);
+    if (status) {
+        xil_printf("RXDBG UART START FAILED result=%d state=%s; r releases a saved capture\r\n",
+            status, capture_store_state_name());
+        return 1;
+    }
+    while (capture_store.state == CAP_STORE_CAPTURING) rx_control_poll();
+    xil_printf("RXDBG UART END id=%s result=%d state=%s\r\n",
+        capture_store.id, capture_store.result, capture_store_state_name());
+    return 1;
+}
