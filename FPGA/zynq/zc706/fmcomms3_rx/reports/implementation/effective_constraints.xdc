####################################################################################
# Constraints from file : 'zc706_board.xdc'
####################################################################################

# Fixed 200 MHz board oscillator, H9/G9, bank 34 VCCO=1.5 V.
# External 100 Ohm clock termination is on the ZC706 PCB.
current_instance -quiet
set_property -dict {PACKAGE_PIN H9 IOSTANDARD DIFF_SSTL15} [get_ports {sys_clk_clk_p[0]}]
set_property -dict {PACKAGE_PIN G9 IOSTANDARD DIFF_SSTL15} [get_ports {sys_clk_clk_n[0]}]
create_clock -period 5.000 -name board_clk200 [get_ports {sys_clk_clk_p[0]}]
# SW13 PL_CPU_RESET is active HIGH; the board wrapper inverts it for old rstn.
set_property -dict {PACKAGE_PIN A8 IOSTANDARD LVCMOS15} [get_ports cpu_reset]
set_false_path -from [get_ports cpu_reset]
# SW9 centre button is active HIGH; the wrapper preserves old KEY1 polarity.
set_property -dict {PACKAGE_PIN K15 IOSTANDARD LVCMOS15} [get_ports key_0]
set_false_path -from [get_ports key_0]
# Static register-controlled ENSM/MGC outputs have no external sampling clock.
set_false_path -to [get_ports {rf_enable rf_txnrx rf_en_agc rf_sync_in}]
# PS SPI uses EMIO at low speed and is polled by software; apply a generous
# external round-trip bound rather than borrowing the RX source clock.
set_max_delay -datapath_only -from [get_ports SPI_9361_io1_io] 20.000
# DDR3 RESET# is an asynchronous JEDEC initialization control, not DQ data.
set_false_path -to [get_ports DDR3_0_reset_n]


####################################################################################
# Constraints from file : 'zc706_fmcomms3_hpc.xdc'
####################################################################################

# ZC706 Rev 2.0, XC7Z045-2FFG900; FMCOMMS3 on J37 FMC HPC.
# Sources: local ZC706_Rev2_0.pdf FPGA-bank/FMC sheets; FMCOMMS3 Rev A.
# FMC banks 11/13 are HR, supplied by VADJ_FPGA=2.5 V (board default).
# Keep VADJ=2.5 V for this bitstream. Native receive termination is enabled.

# G6: FMC_HPC_LA00_CC_P
set_property -dict {PACKAGE_PIN AF20 IOSTANDARD LVDS_25 DIFF_TERM 1} [get_ports rx_clk_p]
# G7: FMC_HPC_LA00_CC_N
set_property -dict {PACKAGE_PIN AG20 IOSTANDARD LVDS_25 DIFF_TERM 1} [get_ports rx_clk_n]
# D8: FMC_HPC_LA01_CC_P
set_property -dict {PACKAGE_PIN AG21 IOSTANDARD LVDS_25 DIFF_TERM 1} [get_ports rx_frame_p]
# D9: FMC_HPC_LA01_CC_N
set_property -dict {PACKAGE_PIN AH21 IOSTANDARD LVDS_25 DIFF_TERM 1} [get_ports rx_frame_n]
# H7: FMC_HPC_LA02_P
set_property -dict {PACKAGE_PIN AK17 IOSTANDARD LVDS_25 DIFF_TERM 1} [get_ports {rx_data_p[0]}]
# H8: FMC_HPC_LA02_N
set_property -dict {PACKAGE_PIN AK18 IOSTANDARD LVDS_25 DIFF_TERM 1} [get_ports {rx_data_n[0]}]
# G9: FMC_HPC_LA03_P
set_property -dict {PACKAGE_PIN AH19 IOSTANDARD LVDS_25 DIFF_TERM 1} [get_ports {rx_data_p[1]}]
# G10: FMC_HPC_LA03_N
set_property -dict {PACKAGE_PIN AJ19 IOSTANDARD LVDS_25 DIFF_TERM 1} [get_ports {rx_data_n[1]}]
# H10: FMC_HPC_LA04_P
set_property -dict {PACKAGE_PIN AJ20 IOSTANDARD LVDS_25 DIFF_TERM 1} [get_ports {rx_data_p[2]}]
# H11: FMC_HPC_LA04_N
set_property -dict {PACKAGE_PIN AK20 IOSTANDARD LVDS_25 DIFF_TERM 1} [get_ports {rx_data_n[2]}]
# D11: FMC_HPC_LA05_P
set_property -dict {PACKAGE_PIN AH23 IOSTANDARD LVDS_25 DIFF_TERM 1} [get_ports {rx_data_p[3]}]
# D12: FMC_HPC_LA05_N
set_property -dict {PACKAGE_PIN AH24 IOSTANDARD LVDS_25 DIFF_TERM 1} [get_ports {rx_data_n[3]}]
# C10: FMC_HPC_LA06_P
set_property -dict {PACKAGE_PIN AG22 IOSTANDARD LVDS_25 DIFF_TERM 1} [get_ports {rx_data_p[4]}]
# C11: FMC_HPC_LA06_N
set_property -dict {PACKAGE_PIN AH22 IOSTANDARD LVDS_25 DIFF_TERM 1} [get_ports {rx_data_n[4]}]
# H13: FMC_HPC_LA07_P
set_property -dict {PACKAGE_PIN AJ23 IOSTANDARD LVDS_25 DIFF_TERM 1} [get_ports {rx_data_p[5]}]
# H14: FMC_HPC_LA07_N
set_property -dict {PACKAGE_PIN AJ24 IOSTANDARD LVDS_25 DIFF_TERM 1} [get_ports {rx_data_n[5]}]
# C26: FMC_HPC_LA27_P
set_property -dict {PACKAGE_PIN V28 IOSTANDARD LVCMOS25} [get_ports SPI_9361_io0_io]
# C27: FMC_HPC_LA27_N
set_property -dict {PACKAGE_PIN V29 IOSTANDARD LVCMOS25} [get_ports SPI_9361_io1_io]
# D27: FMC_HPC_LA26_N
set_property -dict {PACKAGE_PIN T28 IOSTANDARD LVCMOS25} [get_ports SPI_9361_sck_io]
# D26: FMC_HPC_LA26_P
set_property PACKAGE_PIN R28 [get_ports SPI_9361_ss_io]
set_property IOSTANDARD LVCMOS25 [get_ports SPI_9361_ss_io]
set_property PULLUP true [get_ports SPI_9361_ss_io]
# H31: FMC_HPC_LA28_P
set_property -dict {PACKAGE_PIN P30 IOSTANDARD LVCMOS25} [get_ports {GPIO_PS_tri_io[0]}]
# G18: FMC_HPC_LA16_P
set_property -dict {PACKAGE_PIN AA24 IOSTANDARD LVCMOS25} [get_ports rf_enable]
# G19: FMC_HPC_LA16_N
set_property -dict {PACKAGE_PIN AB24 IOSTANDARD LVCMOS25} [get_ports rf_txnrx]
# H22: FMC_HPC_LA19_P
set_property -dict {PACKAGE_PIN T24 IOSTANDARD LVCMOS25} [get_ports rf_en_agc]
# H23: FMC_HPC_LA19_N
set_property -dict {PACKAGE_PIN T25 IOSTANDARD LVCMOS25} [get_ports rf_sync_in]

create_clock -period 16.276 -name rfmc_rx [get_ports rx_clk_p]
set_clock_uncertainty -setup 0.100 [get_clocks rfmc_rx]
set_clock_uncertainty -hold 0.050 [get_clocks rfmc_rx]


####################################################################################
# Constraints from file : 'zc706_ris_lpc.xdc'
####################################################################################

# 25 RIS outputs: row-major out_1_1_0..out_5_5_0 to LPC LA00..LA12 P/N.
# User confirmed no existing wiring; voltage is 2.5 V, single-ended.
# J5 is FMC LPC. This connector must remain free of the RF card.

# J5 G6: FMC_LPC_LA00_CC_P
set_property -dict {PACKAGE_PIN AE13 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_1_1_0]
# J5 G7: FMC_LPC_LA00_CC_N
set_property -dict {PACKAGE_PIN AF13 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_1_2_0]
# J5 D8: FMC_LPC_LA01_CC_P
set_property -dict {PACKAGE_PIN AF15 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_1_3_0]
# J5 D9: FMC_LPC_LA01_CC_N
set_property -dict {PACKAGE_PIN AG15 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_1_4_0]
# J5 H7: FMC_LPC_LA02_P
set_property -dict {PACKAGE_PIN AE12 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_1_5_0]
# J5 H8: FMC_LPC_LA02_N
set_property -dict {PACKAGE_PIN AF12 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_2_1_0]
# J5 G9: FMC_LPC_LA03_P
set_property -dict {PACKAGE_PIN AG12 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_2_2_0]
# J5 G10: FMC_LPC_LA03_N
set_property -dict {PACKAGE_PIN AH12 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_2_3_0]
# J5 H10: FMC_LPC_LA04_P
set_property -dict {PACKAGE_PIN AJ15 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_2_4_0]
# J5 H11: FMC_LPC_LA04_N
set_property -dict {PACKAGE_PIN AK15 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_2_5_0]
# J5 D11: FMC_LPC_LA05_P
set_property -dict {PACKAGE_PIN AE16 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_3_1_0]
# J5 D12: FMC_LPC_LA05_N
set_property -dict {PACKAGE_PIN AE15 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_3_2_0]
# J5 C10: FMC_LPC_LA06_P
set_property -dict {PACKAGE_PIN AB12 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_3_3_0]
# J5 C11: FMC_LPC_LA06_N
set_property -dict {PACKAGE_PIN AC12 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_3_4_0]
# J5 H13: FMC_LPC_LA07_P
set_property -dict {PACKAGE_PIN AA15 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_3_5_0]
# J5 H14: FMC_LPC_LA07_N
set_property -dict {PACKAGE_PIN AA14 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_4_1_0]
# J5 G12: FMC_LPC_LA08_P
set_property -dict {PACKAGE_PIN AD14 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_4_2_0]
# J5 G13: FMC_LPC_LA08_N
set_property -dict {PACKAGE_PIN AD13 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_4_3_0]
# J5 D14: FMC_LPC_LA09_P
set_property -dict {PACKAGE_PIN AH14 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_4_4_0]
# J5 D15: FMC_LPC_LA09_N
set_property -dict {PACKAGE_PIN AH13 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_4_5_0]
# J5 C14: FMC_LPC_LA10_P
set_property -dict {PACKAGE_PIN AC14 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_5_1_0]
# J5 C15: FMC_LPC_LA10_N
set_property -dict {PACKAGE_PIN AC13 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_5_2_0]
# J5 H16: FMC_LPC_LA11_P
set_property -dict {PACKAGE_PIN AJ16 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_5_3_0]
# J5 H17: FMC_LPC_LA11_N
set_property -dict {PACKAGE_PIN AK16 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_5_4_0]
# J5 G15: FMC_LPC_LA12_P
set_property -dict {PACKAGE_PIN AD16 IOSTANDARD LVCMOS25 DRIVE 8 SLEW SLOW} [get_ports out_5_5_0]

# Outputs are asynchronous control levels; there is no external sampling clock.
set_false_path -to [get_ports out_*]


####################################################################################
# Constraints from file : 'zc706_rx_timing.xdc'
####################################################################################

# Boot operating point: config915, 006=0x0f, seven FPGA IDELAY taps=4.
# AD9361 Rev G p9: LVDS clock-to-data and clock-to-FRAME 0.25..1.25 ns.
# UG671 register 006: data/FRAME delay is typically 0.3 ns/LSB.
# The delay-cell PVT envelope below (0.20..0.40 ns/tap) and +/-0.50 ns PCB
# clock/data skew are explicit engineering budgets, not measured or vendor-
# guaranteed board limits. Retain them as assumptions for manual PN/debug.
# Static timing covers boot taps=4; runtime IDELAY tuning requires PN checks.
set_input_delay -clock [get_clocks rfmc_rx] -min 2.750 [get_ports {rx_frame_p {rx_data_p[*]}}]
set_input_delay -clock [get_clocks rfmc_rx] -max 7.750 [get_ports {rx_frame_p {rx_data_p[*]}}]
set_input_delay -clock [get_clocks rfmc_rx] -clock_fall -min -add_delay 2.750 [get_ports {rx_frame_p {rx_data_p[*]}}]
set_input_delay -clock [get_clocks rfmc_rx] -clock_fall -max -add_delay 7.750 [get_ports {rx_frame_p {rx_data_p[*]}}]

# Mode-1 PS SPI0, unchanged 651 kHz nominal software divider. The PS7 owns
# the internal serial-clock timing; these external budgets describe the slow
# peripheral/IOBUF boundary, independently of the unrelated RX clock.
create_clock -period 1536.000 -name spi_external_budget
set_input_delay -clock [get_clocks spi_external_budget] -min 0.000 [get_ports {SPI_9361_io0_io SPI_9361_io1_io SPI_9361_sck_io SPI_9361_ss_io {GPIO_PS_tri_io[0]}}]
set_input_delay -clock [get_clocks spi_external_budget] -max 100.000 [get_ports {SPI_9361_io0_io SPI_9361_io1_io SPI_9361_sck_io SPI_9361_ss_io {GPIO_PS_tri_io[0]}}]
set_output_delay -clock [get_clocks spi_external_budget] -min 0.000 [get_ports {SPI_9361_io0_io SPI_9361_io1_io SPI_9361_sck_io SPI_9361_ss_io {GPIO_PS_tri_io[0]}}]
set_output_delay -clock [get_clocks spi_external_budget] -max 10.000 [get_ports {SPI_9361_io0_io SPI_9361_io1_io SPI_9361_sck_io SPI_9361_ss_io {GPIO_PS_tri_io[0]}}]

# ZC706 input-clock insertion leaves about 0.2 ns negative hold at zero taps.
# Four reference-calibrated IDELAY taps provide ~0.31 ns initial input delay.
# AXI IDELAY registers/readback and runtime PN scan remain unchanged.
set_property IDELAY_VALUE 4 [get_cells -hier -filter {NAME =~ *ad9361_rx_axis_0* && REF_NAME == IDELAYE2}]


