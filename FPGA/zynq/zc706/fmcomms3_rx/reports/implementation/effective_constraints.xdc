## INFO: Level CDC Crossing in AXI DMA

current_instance -quiet
current_instance u_design_1_wrapper/design_1_i/axi_dma_0/U0
set_false_path -to [get_pins -hier *cdc_to*/D]

create_waiver -type CDC -id {CDC-1} -user "axi_dma" -desc "The CDC-1 warning is waived as it is safe in the context of AXI DMA. The Address and Data value does not change until AXI transaction is complete." -tags "9601" -scope -internal -to [get_pins -hier -quiet -filter {NAME =~*I_AXI_DMA_REG_MODULE/GEN_AXI_LITE_IF.AXI_LITE_IF_I/GEN_ASYNC_WRITE.REG_WADDR_TO_IPCLK/GENERATE_LEVEL_P_S_CDC.MULTI_BIT.FOR_IN_cdc_to[*].CROSS2_PLEVEL_IN2SCNDRY_IN_cdc_to/D}] -timestamp "Wed Oct 21 09:20:23 GMT 2026"

create_waiver -type CDC -id {CDC-1} -user "axi_dma" -desc "The CDC-1 warning is waived as it is safe in the context of AXI DMA. The Address and Data value does not change until AXI transaction is complete." -tags "9601" -scope -internal -to [get_pins -hier -quiet -filter {NAME =~*I_AXI_DMA_REG_MODULE/GEN_AXI_LITE_IF.AXI_LITE_IF_I/GEN_ASYNC_WRITE.REG_WADDR_TO_IPCLK1/GENERATE_LEVEL_P_S_CDC.MULTI_BIT.FOR_IN_cdc_to[*].CROSS2_PLEVEL_IN2SCNDRY_IN_cdc_to/D}] -timestamp "Wed Oct 21 09:20:23 GMT 2026"

