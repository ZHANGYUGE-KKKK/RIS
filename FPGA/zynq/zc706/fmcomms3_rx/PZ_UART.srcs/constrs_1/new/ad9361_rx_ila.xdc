# Receiver ILA: synchronized status and actual transfers in AXIS 100 MHz.
# Explicit commands: the Vivado XDC parser does not allow Tcl control flow.
create_debug_core ila_ad9361_rx ila
set_property -dict {C_DATA_DEPTH 4096 C_INPUT_PIPE_STAGES 2 C_ADV_TRIGGER false C_EN_STRG_QUAL false} [get_debug_cores ila_ad9361_rx]
set_property port_width 1 [get_debug_ports ila_ad9361_rx/clk]
connect_debug_port ila_ad9361_rx/clk [get_nets -of_objects [get_pins {u_design_1_wrapper/design_1_i/ad9361_rx_axis_0/inst/m_axis_aclk}]]
set_property port_width 64 [get_debug_ports ila_ad9361_rx/probe0]
